# CodeAtlas Centralized Environment Configuration Template

# Gemini API Key (Required for RAG Q&A and Vector Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Embedding & Multi-Window Rate Limiter Quota Configuration
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_MAX_BATCH_SIZE=100
GEMINI_RPM_LIMIT=100
GEMINI_TPM_LIMIT=30000
GEMINI_RPD_LIMIT=1000

# Backend Configuration
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/codeatlas
JWT_SECRET=supersecretkey_change_in_production_123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=./uploads

# Frontend Configuration
VITE_API_BASE_URL=/api
