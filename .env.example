# CodeAtlas Environment Configuration

# Gemini API Key (Required for RAG Q&A and Vector Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL (Defaults to local SQLite if Postgres is not running, or PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/codeatlas

# Security
JWT_SECRET=supersecretkey_change_in_production_123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Upload directory
UPLOAD_DIR=./uploads
